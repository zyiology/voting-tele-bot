TELEGRAM_BOT_TOKEN=replace-me

# Postgres credentials. Used by the db container and to construct DATABASE_URL.
# Keep DATABASE_URL consistent with these values.
POSTGRES_USER=voting_bot
POSTGRES_PASSWORD=voting_bot
POSTGRES_DB=voting_bot
DATABASE_URL=postgresql://voting_bot:voting_bot@db:5432/voting_bot

VOTER_HASH_SECRET=replace-with-a-long-random-secret
SCORE_MIN=0
SCORE_MAX=5
LOG_LEVEL=INFO
